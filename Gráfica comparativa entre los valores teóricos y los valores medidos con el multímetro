import matplotlib.pyplot as plt
import numpy as np

v_prog = np.array([0, 0.5, 1, 1.5, 2, 2.5, 3, 3.3])
v_dac_mult = np.array([0.090, 0.560, 1.023, 1.496, 1.955, 2.413, 2.884, 3.165])
v_pwm_mult = np.array([0.001, 0.500, 0.987, 1.486, 1.986, 2.472, 2.972, 3.279])

fig, ax = plt.subplots(figsize=(7, 6))
ax.plot(v_prog, v_prog, 'k--', linewidth=1, label='Ideal (V medido = V programado)')
ax.plot(v_prog, v_dac_mult, 'o-', color='#1f77b4', linewidth=2, markersize=7, label='DAC (Nodo D) — Multímetro')
ax.plot(v_prog, v_pwm_mult, 's-', color='#d62728', linewidth=2, markersize=7, label='PWM filtrado — Multímetro')

for x, y in zip(v_prog, v_dac_mult):
    ax.annotate(f'{y:.3f}', (x, y), textcoords="offset points", xytext=(-5, 8), fontsize=8, color='#1f77b4', ha='right')
for x, y in zip(v_prog, v_pwm_mult):
    ax.annotate(f'{y:.3f}', (x, y), textcoords="offset points", xytext=(5, -12), fontsize=8, color='#d62728', ha='left')

ax.set_xlabel('V programado (V)', fontsize=12)
ax.set_ylabel('V medido (V)', fontsize=12)
ax.set_title('Curva de calibración: V medido vs. V programado\nDAC vs. PWM filtrado (ESP32) — Multímetro', fontsize=13)
ax.set_xlim(-0.1, 3.5)
ax.set_ylim(-0.1, 3.5)
ax.grid(True, linestyle=':', alpha=0.6)
ax.legend(fontsize=10, loc='upper left')
ax.set_aspect('equal', adjustable='box')
plt.tight_layout()
plt.show()
